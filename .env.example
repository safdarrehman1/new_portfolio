# =================================================================
# SAFDAR REHMAN PORTFOLIO — ENVIRONMENT VARIABLES
# =================================================================

# 1. Contact Form Destination (Where inquiries get sent)
CONTACT_TO_EMAIL=safdarrehman.dev@gmail.com

# 2. Public Contact Email (Displayed in UI and footer)
NEXT_PUBLIC_CONTACT_EMAIL=safdarrehman.dev@gmail.com

# 3. Canonical Website URL (Used in sitemaps, robots.txt, metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =================================================================
# EMAIL DISPATCH CONFIGURATION (Choose Option A or Option B)
# If neither is set, inquiries are logged safely in simulation mode
# =================================================================

# OPTION A: Resend API (Recommended for production & Vercel)
# Sign up free at https://resend.com and generate an API key
RESEND_API_KEY=

# OPTION B: Nodemailer with Gmail SMTP
# 1. Enable 2-Step Verification on your Google Account
# 2. Visit https://myaccount.google.com/apppasswords to create a 16-character App Password
GMAIL_USER=
GMAIL_APP_PASSWORD=
